  "repro_go": "package main\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"github.com/wowsims/forever/sim\"\n\t\"github.com/wowsims/forever/sim/core\"\n\t\"github.com/wowsims/forever/sim/core/proto\"\n\t\"github.com/wowsims/forever/sim/core/simsignals\"\n\t\"github.com/wowsims/forever/sim/core/spelldata\"\n\t\"github.com/wowsims/forever/sim/core/stats\"\n\t\"google.golang.org/protobuf/encoding/protojson\"\n\t\"math\"\n\t\"os\"\n)\n\ntype Dist struct {\n\tCount              int\n\tMean, SE, Min, Max float64\n}\n\nfunc dist(xs []float64) Dist {\n\td := Dist{Count: len(xs), Min: math.Inf(1)}\n\tfor _, x := range xs {\n\t\td.Mean += x\n\t\td.Min = math.Min(d.Min, x)\n\t\td.Max = math.Max(d.Max, x)\n\t}\n\td.Mean /= float64(d.Count)\n\tfor _, x := range xs {\n\t\td.SE += (x - d.Mean) * (x - d.Mean)\n\t}\n\td.SE = math.Sqrt(d.SE / (float64(d.Count) * float64(d.Count-1)))\n\treturn d\n}\n\ntype Result struct {\n\tWeaponID, SpellID                                                                                   int32\n\tBaseMin, BaseMax, Speed, AP, FlatAt60, NormalizedSpeed, CritMultiplier, CritChance, ArmorMultiplier float64\n\tHit, Crit                                                                                           Dist\n}\n\nfunc run(base []byte, id int32) []Result {\n\tr := &proto.RaidSimRequest{}\n\tif err := protojson.Unmarshal(base, r); err != nil {\n\t\tpanic(err)\n\t}\n\tr.Raid.Parties[0].Players[0].Equipment.Items[14].Id = id\n\tt := core.FreshDefaultTargetConfig()\n\tt.Level = 60\n\tt.Name = \"Humanoid level 60, 3500 armor\"\n\tt.MobType = proto.MobType_MobTypeHumanoid\n\tt.Stats[stats.Armor] = 3500\n\tt.Stats[stats.BlockValue] = 0\n\tr.Encounter = &proto.Encounter{Duration: 30, Targets: []*proto.Target{t}}\n\tr.SimOptions = &proto.SimOptions{RandomSeed: 4242, Iterations: 1}\n\ts := core.NewSim(r, simsignals.CreateSignals())\n\ts.Reset()\n\twar := s.Raid.Parties[0].Players[0].GetCharacter()\n\ttarget := s.Encounter.AllTargetUnits[0]\n\tat := war.AttackTables[target.UnitIndex]\n\twep := war.AutoAttacks.MH()\n\tresults := []Result{}\n\tfor _, spellID := range []int32{21553, 11585} {\n\t\trow := spelldata.MustFind(spellID)\n\t\tspell := war.GetSpell(core.ActionID{SpellID: spellID})\n\t\tif spell == nil {\n\t\t\tpanic(fmt.Sprintf(\"missing %v\", spellID))\n\t\t}\n\t\tap := spell.MeleeAttackPower(target)\n\t\tr := Result{WeaponID: id, SpellID: spellID, BaseMin: wep.BaseDamageMin, BaseMax: wep.BaseDamageMax, Speed: wep.SwingSpeed, AP: ap, NormalizedSpeed: wep.NormalizedSwingSpeed, FlatAt60: row.WeaponStrike(s, spell, 0, 0), CritMultiplier: spell.CritDamageMultiplier(at), CritChance: spell.PhysicalCritChance(at), ArmorMultiplier: at.GetArmorDamageModifier(spell)}\n\t\tvar hits, crits []float64\n\t\ts.Reseed(4242)\n\t\tfor range 100000 {\n\t\t\td := row.WeaponStrike(s, spell, war.MHNormalizedWeaponDamage(s, ap), 0)\n\t\t\tres := spell.CalcDamage(s, target, d, spell.OutcomeMeleeWeaponSpecialHitAndCrit)\n\t\t\tswitch res.Outcome {\n\t\t\tcase core.OutcomeHit:\n\t\t\t\thits = append(hits, res.Damage)\n\t\t\tcase core.OutcomeCrit:\n\t\t\t\tcrits = append(crits, res.Damage)\n\t\t\t}\n\t\t\tspell.DisposeResult(res)\n\t\t}\n\t\tr.Hit = dist(hits)\n\t\tr.Crit = dist(crits)\n\t\tresults = append(results, r)\n\t}\n\treturn results\n}\nfunc main() {\n\tsim.RegisterAll()\n\tbs, err := os.ReadFile(os.Args[1])\n\tif err != nil {\n\t\tpanic(err)\n\t}\n\tresults := []Result{}\n\tfor _, id := range []int32{2801, 12784, 19169, 19323, 279260, 280018, 12592, 18830, 18538, 21134, 1263, 271924} {\n\t\tresults = append(results, run(bs, id)...)\n\t}\n\tout, _ := json.MarshalIndent(results, \"\", \"  \")\n\tfmt.Println(string(out))\n}\n",
